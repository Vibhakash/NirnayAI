# ============================================================
# NirnayAI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ============================================================
# MISTRAL AI  (Required)
# Get from: https://console.mistral.ai → API Keys → Create
# ============================================================
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_LARGE=mistral-large-latest
MISTRAL_MODEL_SMALL=mistral-small-latest

# ============================================================
# MONGODB ATLAS  (Required)
# Get from: https://mongodb.com/atlas
#   → Create free M0 cluster
#   → Database Access → Add user (username + password)
#   → Network Access → Add IP 0.0.0.0/0
#   → Connect → Drivers → Copy connection string
#   → Replace <password> with your DB user password
# ============================================================
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=nirnayai

# ============================================================
# SECURITY  (Required)
# Generate SECRET_KEY by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
SECRET_KEY=replace_with_64_char_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# OCR — EasyOCR  (No binary install needed — pip only)
# Languages: "en" for English, "hi" for Hindi
# Models download automatically on first run (~500MB)
# Confidence below this threshold auto-flags for human review
# ============================================================
OCR_LANGUAGES=en,hi
OCR_CONFIDENCE_THRESHOLD=0.70
OCR_USE_GPU=false

# ============================================================
# AI EVALUATION THRESHOLDS
# LLM confidence below this threshold → NEEDS_REVIEW verdict
# ============================================================
LLM_CONFIDENCE_THRESHOLD=0.75

# ============================================================
# FILE STORAGE  (local filesystem for prototype)
# UPLOAD_DIR is relative to backend root
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ============================================================
# APPLICATION
# CORS_ORIGINS: URL where frontend runs (Vite default: 5173)
# ============================================================
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
APP_HOST=0.0.0.0
APP_PORT=8000
